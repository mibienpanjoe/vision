# make setup generates private random credentials when .env does not exist.
# This file is a field reference, not a ready-to-use credential file.
POSTGRES_PASSWORD=
POSTGRES_PORT=55432
DATABASE_URL=
REDIS_PASSWORD=
REDIS_PORT=56379
REDIS_URL=
VISION_WEB_ORIGINS=http://127.0.0.1:3000,http://localhost:3000
VISION_API_ORIGIN=http://127.0.0.1:8000
# Narrative mode (DEC-38): local (default, on-device), live (gateway; synthetic fixtures only) or off.
VISION_NARRATIVE_PROVIDER=local
# Local FreeLLM gateway (DEC-24); leave the key empty to disable live model calls.
VISION_LLM_API_KEY=
VISION_LLM_BASE_URL=http://127.0.0.1:3001/v1
VISION_LLM_MODEL=auto
# Optional billed image rendering (DEC-51): openai (gpt-image-2, OPENAI_API_KEY) or huggingface (FLUX.1-schnell, HF_TOKEN).
VISION_RENDER_PROVIDER=
# Optional approved alternative model: gpt-image-1 (openai only).
VISION_RENDER_MODEL=
OPENAI_API_KEY=
