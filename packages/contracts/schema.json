{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:vision:contracts:1.0",
  "$defs": {
    "ContextChoice": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_-]+$",
          "title": "Id",
          "type": "string"
        },
        "label": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Label",
          "type": "string"
        }
      },
      "required": [
        "id",
        "label"
      ],
      "title": "ContextChoice",
      "type": "object"
    },
    "ErrorEnvelope": {
      "additionalProperties": false,
      "properties": {
        "error": {
          "$ref": "#/$defs/SafeError"
        }
      },
      "required": [
        "error"
      ],
      "title": "ErrorEnvelope",
      "type": "object"
    },
    "EvidenceRequest": {
      "additionalProperties": false,
      "properties": {
        "context_after": {
          "default": 100,
          "maximum": 500,
          "minimum": 0,
          "title": "Context After",
          "type": "integer"
        },
        "context_before": {
          "default": 100,
          "maximum": 500,
          "minimum": 0,
          "title": "Context Before",
          "type": "integer"
        },
        "parser_revision": {
          "maxLength": 32,
          "minLength": 1,
          "pattern": "^[a-zA-Z0-9_-]+$",
          "title": "Parser Revision",
          "type": "string"
        },
        "reading_boundary": {
          "discriminator": {
            "mapping": {
              "through_chapter": "#/$defs/ThroughChapter",
              "whole_book": "#/$defs/WholeBook"
            },
            "propertyName": "mode"
          },
          "oneOf": [
            {
              "$ref": "#/$defs/WholeBook"
            },
            {
              "$ref": "#/$defs/ThroughChapter"
            }
          ],
          "title": "Reading Boundary"
        },
        "span": {
          "$ref": "#/$defs/EvidenceSpan"
        }
      },
      "required": [
        "span",
        "parser_revision",
        "reading_boundary"
      ],
      "title": "EvidenceRequest",
      "type": "object"
    },
    "EvidenceSpan": {
      "additionalProperties": false,
      "properties": {
        "document_revision_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_-]+$",
          "title": "Document Revision Id",
          "type": "string"
        },
        "end": {
          "exclusiveMinimum": 0,
          "title": "End",
          "type": "integer"
        },
        "offset_unit": {
          "const": "unicode_code_point",
          "default": "unicode_code_point",
          "title": "Offset Unit",
          "type": "string"
        },
        "passage_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_-]+$",
          "title": "Passage Id",
          "type": "string"
        },
        "quote": {
          "maxLength": 2000,
          "minLength": 1,
          "title": "Quote",
          "type": "string"
        },
        "start": {
          "minimum": 0,
          "title": "Start",
          "type": "integer"
        }
      },
      "required": [
        "document_revision_id",
        "passage_id",
        "start",
        "end",
        "quote"
      ],
      "title": "EvidenceSpan",
      "type": "object"
    },
    "EvidenceView": {
      "additionalProperties": false,
      "properties": {
        "chapter_id": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Chapter Id"
        },
        "excerpt": {
          "maxLength": 3000,
          "title": "Excerpt",
          "type": "string"
        },
        "excerpt_start": {
          "minimum": 0,
          "title": "Excerpt Start",
          "type": "integer"
        },
        "highlight_end": {
          "exclusiveMinimum": 0,
          "title": "Highlight End",
          "type": "integer"
        },
        "highlight_start": {
          "minimum": 0,
          "title": "Highlight Start",
          "type": "integer"
        },
        "original_end": {
          "exclusiveMinimum": 0,
          "title": "Original End",
          "type": "integer"
        },
        "original_start": {
          "minimum": 0,
          "title": "Original Start",
          "type": "integer"
        },
        "parser_revision": {
          "title": "Parser Revision",
          "type": "string"
        },
        "span": {
          "$ref": "#/$defs/SourceSpan"
        }
      },
      "required": [
        "span",
        "parser_revision",
        "excerpt",
        "excerpt_start",
        "highlight_start",
        "highlight_end",
        "original_start",
        "original_end",
        "chapter_id"
      ],
      "title": "EvidenceView",
      "type": "object"
    },
    "Failed": {
      "additionalProperties": false,
      "properties": {
        "error": {
          "$ref": "#/$defs/SafeError"
        },
        "outcome": {
          "const": "failed",
          "title": "Outcome",
          "type": "string"
        },
        "schema_version": {
          "const": "1.0",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "outcome",
        "schema_version",
        "error"
      ],
      "title": "Failed",
      "type": "object"
    },
    "IngestionView": {
      "additionalProperties": false,
      "properties": {
        "attempts": {
          "minimum": 0,
          "title": "Attempts",
          "type": "integer"
        },
        "correlation_id": {
          "title": "Correlation Id",
          "type": "string"
        },
        "dispatch_pending": {
          "title": "Dispatch Pending",
          "type": "boolean"
        },
        "document_id": {
          "format": "uuid",
          "title": "Document Id",
          "type": "string"
        },
        "error_code": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Error Code"
        },
        "id": {
          "format": "uuid",
          "title": "Id",
          "type": "string"
        },
        "stage": {
          "enum": [
            "awaiting_parser",
            "parsed",
            "failed"
          ],
          "title": "Stage",
          "type": "string"
        },
        "status": {
          "enum": [
            "queued",
            "succeeded",
            "failed"
          ],
          "title": "Status",
          "type": "string"
        },
        "warnings": {
          "items": {
            "type": "string"
          },
          "title": "Warnings",
          "type": "array"
        }
      },
      "required": [
        "id",
        "document_id",
        "status",
        "stage",
        "attempts",
        "error_code",
        "warnings",
        "dispatch_pending",
        "correlation_id"
      ],
      "title": "IngestionView",
      "type": "object"
    },
    "InsufficientEvidence": {
      "additionalProperties": false,
      "properties": {
        "missing": {
          "items": {
            "maxLength": 256,
            "minLength": 1,
            "type": "string"
          },
          "minItems": 1,
          "title": "Missing",
          "type": "array"
        },
        "outcome": {
          "const": "insufficient_evidence",
          "title": "Outcome",
          "type": "string"
        },
        "schema_version": {
          "const": "1.0",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "outcome",
        "schema_version",
        "missing"
      ],
      "title": "InsufficientEvidence",
      "type": "object"
    },
    "JobView": {
      "additionalProperties": false,
      "properties": {
        "attempts": {
          "minimum": 0,
          "title": "Attempts",
          "type": "integer"
        },
        "correlation_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_-]+$",
          "title": "Correlation Id",
          "type": "string"
        },
        "dispatch_pending": {
          "title": "Dispatch Pending",
          "type": "boolean"
        },
        "id": {
          "format": "uuid",
          "title": "Id",
          "type": "string"
        },
        "result": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Result"
        },
        "stage": {
          "enum": [
            "queued",
            "complete"
          ],
          "title": "Stage",
          "type": "string"
        },
        "status": {
          "enum": [
            "queued",
            "succeeded"
          ],
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "id",
        "status",
        "stage",
        "attempts",
        "result",
        "correlation_id",
        "dispatch_pending"
      ],
      "title": "JobView",
      "type": "object"
    },
    "LibraryPage": {
      "additionalProperties": false,
      "properties": {
        "items": {
          "items": {
            "$ref": "#/$defs/WorkView"
          },
          "title": "Items",
          "type": "array"
        },
        "next_cursor": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Next Cursor"
        }
      },
      "required": [
        "items",
        "next_cursor"
      ],
      "title": "LibraryPage",
      "type": "object"
    },
    "LoginRequest": {
      "additionalProperties": false,
      "properties": {
        "password": {
          "maxLength": 128,
          "minLength": 12,
          "title": "Password",
          "type": "string"
        },
        "username": {
          "pattern": "^[a-z][a-z0-9_-]{2,31}$",
          "title": "Username",
          "type": "string"
        }
      },
      "required": [
        "username",
        "password"
      ],
      "title": "LoginRequest",
      "type": "object"
    },
    "NeedsContext": {
      "additionalProperties": false,
      "properties": {
        "choices": {
          "items": {
            "$ref": "#/$defs/ContextChoice"
          },
          "minItems": 1,
          "title": "Choices",
          "type": "array"
        },
        "outcome": {
          "const": "needs_context",
          "title": "Outcome",
          "type": "string"
        },
        "schema_version": {
          "const": "1.0",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "outcome",
        "schema_version",
        "choices"
      ],
      "title": "NeedsContext",
      "type": "object"
    },
    "PrincipalView": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "format": "uuid",
          "title": "Id",
          "type": "string"
        },
        "username": {
          "title": "Username",
          "type": "string"
        }
      },
      "required": [
        "id",
        "username"
      ],
      "title": "PrincipalView",
      "type": "object"
    },
    "ProbeRequest": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "probe",
          "default": "probe",
          "title": "Kind",
          "type": "string"
        },
        "value": {
          "default": 0,
          "maximum": 1000000,
          "minimum": 0,
          "title": "Value",
          "type": "integer"
        }
      },
      "title": "ProbeRequest",
      "type": "object"
    },
    "RequestScope": {
      "additionalProperties": false,
      "properties": {
        "creative_mode": {
          "enum": [
            "canon_first",
            "interpretation"
          ],
          "title": "Creative Mode",
          "type": "string"
        },
        "document_revision_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_-]+$",
          "title": "Document Revision Id",
          "type": "string"
        },
        "generation_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_-]+$",
          "title": "Generation Id",
          "type": "string"
        },
        "reading_boundary": {
          "discriminator": {
            "mapping": {
              "through_chapter": "#/$defs/ThroughChapter",
              "whole_book": "#/$defs/WholeBook"
            },
            "propertyName": "mode"
          },
          "oneOf": [
            {
              "$ref": "#/$defs/WholeBook"
            },
            {
              "$ref": "#/$defs/ThroughChapter"
            }
          ],
          "title": "Reading Boundary"
        },
        "story_event_id": {
          "anyOf": [
            {
              "maxLength": 128,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9_-]+$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Story Event Id"
        },
        "work_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_-]+$",
          "title": "Work Id",
          "type": "string"
        }
      },
      "required": [
        "work_id",
        "document_revision_id",
        "generation_id",
        "reading_boundary",
        "creative_mode"
      ],
      "title": "RequestScope",
      "type": "object"
    },
    "Resolved_SourceSpan_": {
      "additionalProperties": false,
      "properties": {
        "data": {
          "$ref": "#/$defs/SourceSpan"
        },
        "outcome": {
          "const": "resolved",
          "title": "Outcome",
          "type": "string"
        },
        "schema_version": {
          "const": "1.0",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "outcome",
        "schema_version",
        "data"
      ],
      "title": "Resolved[SourceSpan]",
      "type": "object"
    },
    "SafeError": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "maxLength": 64,
          "minLength": 1,
          "pattern": "^[A-Z][A-Z0-9_]*$",
          "title": "Code",
          "type": "string"
        },
        "correlation_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_-]+$",
          "title": "Correlation Id",
          "type": "string"
        },
        "message": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Message",
          "type": "string"
        },
        "retryable": {
          "title": "Retryable",
          "type": "boolean"
        }
      },
      "required": [
        "code",
        "message",
        "retryable",
        "correlation_id"
      ],
      "title": "SafeError",
      "type": "object"
    },
    "SourceSpan": {
      "additionalProperties": false,
      "properties": {
        "document_revision_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_-]+$",
          "title": "Document Revision Id",
          "type": "string"
        },
        "end": {
          "exclusiveMinimum": 0,
          "title": "End",
          "type": "integer"
        },
        "offset_unit": {
          "const": "unicode_code_point",
          "default": "unicode_code_point",
          "title": "Offset Unit",
          "type": "string"
        },
        "passage_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_-]+$",
          "title": "Passage Id",
          "type": "string"
        },
        "quote": {
          "minLength": 1,
          "title": "Quote",
          "type": "string"
        },
        "start": {
          "minimum": 0,
          "title": "Start",
          "type": "integer"
        }
      },
      "required": [
        "document_revision_id",
        "passage_id",
        "start",
        "end",
        "quote"
      ],
      "title": "SourceSpan",
      "type": "object"
    },
    "SpanResolution": {
      "discriminator": {
        "mapping": {
          "failed": "#/$defs/Failed",
          "insufficient_evidence": "#/$defs/InsufficientEvidence",
          "needs_context": "#/$defs/NeedsContext",
          "resolved": "#/$defs/Resolved_SourceSpan_"
        },
        "propertyName": "outcome"
      },
      "oneOf": [
        {
          "$ref": "#/$defs/Resolved_SourceSpan_"
        },
        {
          "$ref": "#/$defs/NeedsContext"
        },
        {
          "$ref": "#/$defs/InsufficientEvidence"
        },
        {
          "$ref": "#/$defs/Failed"
        }
      ],
      "title": "SpanResolution"
    },
    "ThroughChapter": {
      "additionalProperties": false,
      "properties": {
        "chapter_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_-]+$",
          "title": "Chapter Id",
          "type": "string"
        },
        "mode": {
          "const": "through_chapter",
          "title": "Mode",
          "type": "string"
        }
      },
      "required": [
        "mode",
        "chapter_id"
      ],
      "title": "ThroughChapter",
      "type": "object"
    },
    "UploadAccepted": {
      "additionalProperties": false,
      "properties": {
        "job": {
          "$ref": "#/$defs/IngestionView"
        },
        "work": {
          "$ref": "#/$defs/WorkView"
        }
      },
      "required": [
        "work",
        "job"
      ],
      "title": "UploadAccepted",
      "type": "object"
    },
    "UploadMetadata": {
      "additionalProperties": false,
      "properties": {
        "format": {
          "enum": [
            "txt",
            "md"
          ],
          "title": "Format",
          "type": "string"
        },
        "title": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Title",
          "type": "string"
        }
      },
      "required": [
        "title",
        "format"
      ],
      "title": "UploadMetadata",
      "type": "object"
    },
    "WholeBook": {
      "additionalProperties": false,
      "properties": {
        "mode": {
          "const": "whole_book",
          "title": "Mode",
          "type": "string"
        }
      },
      "required": [
        "mode"
      ],
      "title": "WholeBook",
      "type": "object"
    },
    "WorkView": {
      "additionalProperties": false,
      "properties": {
        "byte_count": {
          "minimum": 1,
          "title": "Byte Count",
          "type": "integer"
        },
        "document_id": {
          "format": "uuid",
          "title": "Document Id",
          "type": "string"
        },
        "format": {
          "enum": [
            "txt",
            "md"
          ],
          "title": "Format",
          "type": "string"
        },
        "id": {
          "format": "uuid",
          "title": "Id",
          "type": "string"
        },
        "revision": {
          "minimum": 1,
          "title": "Revision",
          "type": "integer"
        },
        "sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "title": {
          "title": "Title",
          "type": "string"
        }
      },
      "required": [
        "id",
        "title",
        "document_id",
        "revision",
        "format",
        "byte_count",
        "sha256"
      ],
      "title": "WorkView",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Build-time export root only; this is not an HTTP request/response.",
  "properties": {
    "error": {
      "$ref": "#/$defs/ErrorEnvelope"
    },
    "evidence": {
      "$ref": "#/$defs/EvidenceView"
    },
    "evidence_request": {
      "$ref": "#/$defs/EvidenceRequest"
    },
    "ingestion": {
      "$ref": "#/$defs/IngestionView"
    },
    "job": {
      "$ref": "#/$defs/JobView"
    },
    "library_page": {
      "$ref": "#/$defs/LibraryPage"
    },
    "login_request": {
      "$ref": "#/$defs/LoginRequest"
    },
    "principal": {
      "$ref": "#/$defs/PrincipalView"
    },
    "probe_request": {
      "$ref": "#/$defs/ProbeRequest"
    },
    "scope": {
      "$ref": "#/$defs/RequestScope"
    },
    "source_span": {
      "$ref": "#/$defs/SourceSpan"
    },
    "span_outcome": {
      "$ref": "#/$defs/SpanResolution"
    },
    "upload_accepted": {
      "$ref": "#/$defs/UploadAccepted"
    },
    "upload_metadata": {
      "$ref": "#/$defs/UploadMetadata"
    },
    "work": {
      "$ref": "#/$defs/WorkView"
    }
  },
  "required": [
    "login_request",
    "principal",
    "probe_request",
    "job",
    "upload_metadata",
    "upload_accepted",
    "work",
    "library_page",
    "ingestion",
    "evidence_request",
    "evidence",
    "source_span",
    "scope",
    "error",
    "span_outcome"
  ],
  "title": "SchemaCatalog",
  "type": "object"
}
