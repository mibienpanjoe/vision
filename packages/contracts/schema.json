{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:vision:contracts:1.0",
  "$defs": {
    "AliasView": {
      "additionalProperties": false,
      "properties": {
        "label": {
          "title": "Label",
          "type": "string"
        },
        "span": {
          "$ref": "#/$defs/SourceSpan"
        },
        "status": {
          "enum": [
            "supported",
            "candidate"
          ],
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "label",
        "status",
        "span"
      ],
      "title": "AliasView",
      "type": "object"
    },
    "AnchorView": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "age",
            "date",
            "relative"
          ],
          "title": "Kind",
          "type": "string"
        },
        "span": {
          "$ref": "#/$defs/SourceSpan"
        },
        "value": {
          "title": "Value",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "value",
        "span"
      ],
      "title": "AnchorView",
      "type": "object"
    },
    "ConflictView": {
      "additionalProperties": false,
      "properties": {
        "fact_ids": {
          "items": {
            "format": "uuid",
            "type": "string"
          },
          "maxItems": 2,
          "minItems": 2,
          "title": "Fact Ids",
          "type": "array"
        },
        "status": {
          "const": "unresolved",
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "fact_ids",
        "status"
      ],
      "title": "ConflictView",
      "type": "object"
    },
    "ContextChoice": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_-]+$",
          "title": "Id",
          "type": "string"
        },
        "label": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Label",
          "type": "string"
        }
      },
      "required": [
        "id",
        "label"
      ],
      "title": "ContextChoice",
      "type": "object"
    },
    "EntityDetail": {
      "additionalProperties": false,
      "properties": {
        "conflicts": {
          "items": {
            "$ref": "#/$defs/ConflictView"
          },
          "title": "Conflicts",
          "type": "array"
        },
        "entity": {
          "$ref": "#/$defs/EntitySummary"
        },
        "event_relations": {
          "items": {
            "$ref": "#/$defs/EventRelationView"
          },
          "title": "Event Relations",
          "type": "array"
        },
        "events": {
          "items": {
            "$ref": "#/$defs/EventView"
          },
          "title": "Events",
          "type": "array"
        },
        "facts": {
          "items": {
            "$ref": "#/$defs/FactView"
          },
          "title": "Facts",
          "type": "array"
        },
        "mentions": {
          "items": {
            "$ref": "#/$defs/MentionView"
          },
          "maxItems": 200,
          "title": "Mentions",
          "type": "array"
        },
        "mentions_truncated": {
          "title": "Mentions Truncated",
          "type": "boolean"
        },
        "relations": {
          "items": {
            "$ref": "#/$defs/RelationView"
          },
          "title": "Relations",
          "type": "array"
        },
        "scope": {
          "$ref": "#/$defs/NarrativeScope"
        }
      },
      "required": [
        "scope",
        "entity",
        "mentions",
        "mentions_truncated",
        "relations",
        "events",
        "event_relations",
        "facts",
        "conflicts"
      ],
      "title": "EntityDetail",
      "type": "object"
    },
    "EntityPage": {
      "additionalProperties": false,
      "properties": {
        "items": {
          "items": {
            "$ref": "#/$defs/EntitySummary"
          },
          "title": "Items",
          "type": "array"
        },
        "scope": {
          "$ref": "#/$defs/NarrativeScope"
        }
      },
      "required": [
        "scope",
        "items"
      ],
      "title": "EntityPage",
      "type": "object"
    },
    "EntitySummary": {
      "additionalProperties": false,
      "properties": {
        "aliases": {
          "items": {
            "$ref": "#/$defs/AliasView"
          },
          "title": "Aliases",
          "type": "array"
        },
        "id": {
          "format": "uuid",
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "enum": [
            "character",
            "place",
            "object",
            "organization"
          ],
          "title": "Kind",
          "type": "string"
        },
        "label": {
          "description": "A name used by an eligible mention",
          "title": "Label",
          "type": "string"
        },
        "mention_count": {
          "minimum": 1,
          "title": "Mention Count",
          "type": "integer"
        }
      },
      "required": [
        "id",
        "kind",
        "label",
        "aliases",
        "mention_count"
      ],
      "title": "EntitySummary",
      "type": "object"
    },
    "ErrorEnvelope": {
      "additionalProperties": false,
      "properties": {
        "error": {
          "$ref": "#/$defs/SafeError"
        }
      },
      "required": [
        "error"
      ],
      "title": "ErrorEnvelope",
      "type": "object"
    },
    "EventRelationView": {
      "additionalProperties": false,
      "properties": {
        "relation": {
          "enum": [
            "before",
            "after",
            "during",
            "overlaps",
            "unknown"
          ],
          "title": "Relation",
          "type": "string"
        },
        "source_id": {
          "format": "uuid",
          "title": "Source Id",
          "type": "string"
        },
        "span": {
          "$ref": "#/$defs/SourceSpan"
        },
        "target_id": {
          "format": "uuid",
          "title": "Target Id",
          "type": "string"
        }
      },
      "required": [
        "source_id",
        "relation",
        "target_id",
        "span"
      ],
      "title": "EventRelationView",
      "type": "object"
    },
    "EventView": {
      "additionalProperties": false,
      "properties": {
        "anchors": {
          "items": {
            "$ref": "#/$defs/AnchorView"
          },
          "title": "Anchors",
          "type": "array"
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/SourceSpan"
          },
          "title": "Evidence",
          "type": "array"
        },
        "id": {
          "format": "uuid",
          "title": "Id",
          "type": "string"
        },
        "label": {
          "title": "Label",
          "type": "string"
        },
        "modality": {
          "title": "Modality",
          "type": "string"
        },
        "participant_ids": {
          "items": {
            "format": "uuid",
            "type": "string"
          },
          "title": "Participant Ids",
          "type": "array"
        }
      },
      "required": [
        "id",
        "label",
        "modality",
        "evidence",
        "participant_ids",
        "anchors"
      ],
      "title": "EventView",
      "type": "object"
    },
    "EvidenceRequest": {
      "additionalProperties": false,
      "properties": {
        "context_after": {
          "default": 100,
          "maximum": 500,
          "minimum": 0,
          "title": "Context After",
          "type": "integer"
        },
        "context_before": {
          "default": 100,
          "maximum": 500,
          "minimum": 0,
          "title": "Context Before",
          "type": "integer"
        },
        "parser_revision": {
          "maxLength": 32,
          "minLength": 1,
          "pattern": "^[a-zA-Z0-9_-]+$",
          "title": "Parser Revision",
          "type": "string"
        },
        "reading_boundary": {
          "discriminator": {
            "mapping": {
              "through_chapter": "#/$defs/ThroughChapter",
              "whole_book": "#/$defs/WholeBook"
            },
            "propertyName": "mode"
          },
          "oneOf": [
            {
              "$ref": "#/$defs/WholeBook"
            },
            {
              "$ref": "#/$defs/ThroughChapter"
            }
          ],
          "title": "Reading Boundary"
        },
        "span": {
          "$ref": "#/$defs/EvidenceSpan"
        }
      },
      "required": [
        "span",
        "parser_revision",
        "reading_boundary"
      ],
      "title": "EvidenceRequest",
      "type": "object"
    },
    "EvidenceSpan": {
      "additionalProperties": false,
      "properties": {
        "document_revision_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_-]+$",
          "title": "Document Revision Id",
          "type": "string"
        },
        "end": {
          "exclusiveMinimum": 0,
          "title": "End",
          "type": "integer"
        },
        "offset_unit": {
          "const": "unicode_code_point",
          "default": "unicode_code_point",
          "title": "Offset Unit",
          "type": "string"
        },
        "passage_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_-]+$",
          "title": "Passage Id",
          "type": "string"
        },
        "quote": {
          "maxLength": 2000,
          "minLength": 1,
          "title": "Quote",
          "type": "string"
        },
        "start": {
          "minimum": 0,
          "title": "Start",
          "type": "integer"
        }
      },
      "required": [
        "document_revision_id",
        "passage_id",
        "start",
        "end",
        "quote"
      ],
      "title": "EvidenceSpan",
      "type": "object"
    },
    "EvidenceView": {
      "additionalProperties": false,
      "properties": {
        "chapter_id": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Chapter Id"
        },
        "excerpt": {
          "maxLength": 3000,
          "title": "Excerpt",
          "type": "string"
        },
        "excerpt_start": {
          "minimum": 0,
          "title": "Excerpt Start",
          "type": "integer"
        },
        "highlight_end": {
          "exclusiveMinimum": 0,
          "title": "Highlight End",
          "type": "integer"
        },
        "highlight_start": {
          "minimum": 0,
          "title": "Highlight Start",
          "type": "integer"
        },
        "original_end": {
          "exclusiveMinimum": 0,
          "title": "Original End",
          "type": "integer"
        },
        "original_start": {
          "minimum": 0,
          "title": "Original Start",
          "type": "integer"
        },
        "pages": {
          "anyOf": [
            {
              "items": {
                "minimum": 1,
                "type": "integer"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "description": "Source pages of the containing passage, when the format has pages",
          "title": "Pages"
        },
        "parser_revision": {
          "title": "Parser Revision",
          "type": "string"
        },
        "section": {
          "anyOf": [
            {
              "maxLength": 1024,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "Content document and fragment of the containing passage, for EPUB",
          "title": "Section"
        },
        "span": {
          "$ref": "#/$defs/SourceSpan"
        }
      },
      "required": [
        "span",
        "parser_revision",
        "excerpt",
        "excerpt_start",
        "highlight_start",
        "highlight_end",
        "original_start",
        "original_end",
        "chapter_id",
        "pages",
        "section"
      ],
      "title": "EvidenceView",
      "type": "object"
    },
    "FactView": {
      "additionalProperties": false,
      "properties": {
        "assumption": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Assumption"
        },
        "attribute": {
          "title": "Attribute",
          "type": "string"
        },
        "canonical": {
          "title": "Canonical",
          "type": "boolean"
        },
        "event_ids": {
          "items": {
            "format": "uuid",
            "type": "string"
          },
          "title": "Event Ids",
          "type": "array"
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/SourceSpan"
          },
          "title": "Evidence",
          "type": "array"
        },
        "id": {
          "format": "uuid",
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "enum": [
            "identity",
            "acquired",
            "interval",
            "scene"
          ],
          "title": "Kind",
          "type": "string"
        },
        "modality": {
          "title": "Modality",
          "type": "string"
        },
        "perspective": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Perspective"
        },
        "polarity": {
          "enum": [
            "affirmed",
            "negated"
          ],
          "title": "Polarity",
          "type": "string"
        },
        "support": {
          "enum": [
            "explicit",
            "inferred"
          ],
          "title": "Support",
          "type": "string"
        },
        "value": {
          "title": "Value",
          "type": "string"
        }
      },
      "required": [
        "id",
        "attribute",
        "value",
        "kind",
        "support",
        "modality",
        "polarity",
        "perspective",
        "assumption",
        "canonical",
        "evidence",
        "event_ids"
      ],
      "title": "FactView",
      "type": "object"
    },
    "Failed": {
      "additionalProperties": false,
      "properties": {
        "error": {
          "$ref": "#/$defs/SafeError"
        },
        "outcome": {
          "const": "failed",
          "title": "Outcome",
          "type": "string"
        },
        "schema_version": {
          "const": "1.0",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "outcome",
        "schema_version",
        "error"
      ],
      "title": "Failed",
      "type": "object"
    },
    "IngestionView": {
      "additionalProperties": false,
      "properties": {
        "attempts": {
          "minimum": 0,
          "title": "Attempts",
          "type": "integer"
        },
        "cancel_requested": {
          "title": "Cancel Requested",
          "type": "boolean"
        },
        "correlation_id": {
          "title": "Correlation Id",
          "type": "string"
        },
        "dispatch_pending": {
          "title": "Dispatch Pending",
          "type": "boolean"
        },
        "document_id": {
          "format": "uuid",
          "title": "Document Id",
          "type": "string"
        },
        "error_code": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Error Code"
        },
        "id": {
          "format": "uuid",
          "title": "Id",
          "type": "string"
        },
        "revision": {
          "minimum": 1,
          "title": "Revision",
          "type": "integer"
        },
        "stage": {
          "enum": [
            "awaiting_parser",
            "parse",
            "parsed",
            "failed",
            "cancelled"
          ],
          "title": "Stage",
          "type": "string"
        },
        "status": {
          "enum": [
            "queued",
            "running",
            "succeeded",
            "failed",
            "cancelled"
          ],
          "title": "Status",
          "type": "string"
        },
        "warnings": {
          "items": {
            "type": "string"
          },
          "title": "Warnings",
          "type": "array"
        }
      },
      "required": [
        "id",
        "document_id",
        "status",
        "stage",
        "revision",
        "cancel_requested",
        "attempts",
        "error_code",
        "warnings",
        "dispatch_pending",
        "correlation_id"
      ],
      "title": "IngestionView",
      "type": "object"
    },
    "InsufficientEvidence": {
      "additionalProperties": false,
      "properties": {
        "missing": {
          "items": {
            "maxLength": 256,
            "minLength": 1,
            "type": "string"
          },
          "minItems": 1,
          "title": "Missing",
          "type": "array"
        },
        "outcome": {
          "const": "insufficient_evidence",
          "title": "Outcome",
          "type": "string"
        },
        "schema_version": {
          "const": "1.0",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "outcome",
        "schema_version",
        "missing"
      ],
      "title": "InsufficientEvidence",
      "type": "object"
    },
    "JobView": {
      "additionalProperties": false,
      "properties": {
        "attempts": {
          "minimum": 0,
          "title": "Attempts",
          "type": "integer"
        },
        "correlation_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_-]+$",
          "title": "Correlation Id",
          "type": "string"
        },
        "dispatch_pending": {
          "title": "Dispatch Pending",
          "type": "boolean"
        },
        "id": {
          "format": "uuid",
          "title": "Id",
          "type": "string"
        },
        "result": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Result"
        },
        "stage": {
          "enum": [
            "queued",
            "complete"
          ],
          "title": "Stage",
          "type": "string"
        },
        "status": {
          "enum": [
            "queued",
            "succeeded"
          ],
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "id",
        "status",
        "stage",
        "attempts",
        "result",
        "correlation_id",
        "dispatch_pending"
      ],
      "title": "JobView",
      "type": "object"
    },
    "LibraryPage": {
      "additionalProperties": false,
      "properties": {
        "items": {
          "items": {
            "$ref": "#/$defs/WorkView"
          },
          "title": "Items",
          "type": "array"
        },
        "next_cursor": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Next Cursor"
        }
      },
      "required": [
        "items",
        "next_cursor"
      ],
      "title": "LibraryPage",
      "type": "object"
    },
    "LoginRequest": {
      "additionalProperties": false,
      "properties": {
        "password": {
          "maxLength": 128,
          "minLength": 12,
          "title": "Password",
          "type": "string"
        },
        "username": {
          "pattern": "^[a-z][a-z0-9_-]{2,31}$",
          "title": "Username",
          "type": "string"
        }
      },
      "required": [
        "username",
        "password"
      ],
      "title": "LoginRequest",
      "type": "object"
    },
    "MentionView": {
      "additionalProperties": false,
      "properties": {
        "candidate_ids": {
          "items": {
            "format": "uuid",
            "type": "string"
          },
          "title": "Candidate Ids",
          "type": "array"
        },
        "entity_id": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "Set only when the source supports one identity",
          "title": "Entity Id"
        },
        "span": {
          "$ref": "#/$defs/SourceSpan"
        }
      },
      "required": [
        "span",
        "entity_id",
        "candidate_ids"
      ],
      "title": "MentionView",
      "type": "object"
    },
    "NarrativeScope": {
      "additionalProperties": false,
      "properties": {
        "generation_id": {
          "format": "uuid",
          "title": "Generation Id",
          "type": "string"
        },
        "parser_revision": {
          "title": "Parser Revision",
          "type": "string"
        },
        "through_chapter_id": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "Reading cutoff; null means the whole book",
          "title": "Through Chapter Id"
        }
      },
      "required": [
        "generation_id",
        "parser_revision",
        "through_chapter_id"
      ],
      "title": "NarrativeScope",
      "type": "object"
    },
    "NeedsContext": {
      "additionalProperties": false,
      "properties": {
        "choices": {
          "items": {
            "$ref": "#/$defs/ContextChoice"
          },
          "minItems": 1,
          "title": "Choices",
          "type": "array"
        },
        "outcome": {
          "const": "needs_context",
          "title": "Outcome",
          "type": "string"
        },
        "schema_version": {
          "const": "1.0",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "outcome",
        "schema_version",
        "choices"
      ],
      "title": "NeedsContext",
      "type": "object"
    },
    "PrincipalView": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "format": "uuid",
          "title": "Id",
          "type": "string"
        },
        "username": {
          "title": "Username",
          "type": "string"
        }
      },
      "required": [
        "id",
        "username"
      ],
      "title": "PrincipalView",
      "type": "object"
    },
    "ProbeRequest": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "probe",
          "default": "probe",
          "title": "Kind",
          "type": "string"
        },
        "value": {
          "default": 0,
          "maximum": 1000000,
          "minimum": 0,
          "title": "Value",
          "type": "integer"
        }
      },
      "title": "ProbeRequest",
      "type": "object"
    },
    "RelationView": {
      "additionalProperties": false,
      "properties": {
        "object_id": {
          "format": "uuid",
          "title": "Object Id",
          "type": "string"
        },
        "relation": {
          "title": "Relation",
          "type": "string"
        },
        "span": {
          "$ref": "#/$defs/SourceSpan"
        },
        "subject_id": {
          "format": "uuid",
          "title": "Subject Id",
          "type": "string"
        }
      },
      "required": [
        "subject_id",
        "relation",
